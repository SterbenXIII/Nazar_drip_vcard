# ==============================================================================
# Environment Configuration Template for astro-vcard
# ==============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)
# ==============================================================================

# ==============================================================================
# 1. INFRASTRUCTURE
# ==============================================================================
DOMAIN_NAME=localhost
NODE_ENV=production
TIMEZONE=Europe/Kyiv

# ==============================================================================
# 2. BACKEND (Hono API)
# ==============================================================================
BACKEND_PORT=5678

# --- GMAIL OAUTH2 for Email Notifications ---
# Get from: https://console.cloud.google.com/
SMTP_USER=your-gmail@gmail.com
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token

# Email where lead notifications will be sent
ADMIN_EMAIL=admin@example.com

# Enabled notification providers (comma-separated)
ENABLED_PROVIDERS=TELEGRAM,EMAIL

# Comma-separated Telegram chat IDs for additional lead notifications
TELEGRAM_NOTIFY_IDS=

# Webhook secret for verifying authenticity
WEBHOOK_SECRET=

# ==============================================================================
# 3. TELEGRAM BOT (Admin notifications)
# ==============================================================================
# Get token from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Your Telegram user ID (get from @userinfobot)
TELEGRAM_MASTER_ID=123456789

# ==============================================================================
# 4. N8N AUTOMATION (Optional)
# ==============================================================================
N8N_PORT=5679
N8N_HOST=localhost
N8N_PROTOCOL=https
# Generate random key: openssl rand -base64 32
N8N_ENCRYPTION_KEY=your-random-32-char-encryption-key
N8N_COMMUNITY_PACKAGES_ENABLED=true
GENERIC_TIMEZONE=Europe/Kyiv

# --- PostgreSQL for n8n ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=your-secure-postgres-password

# ==============================================================================
# 5. FRONTEND (Astro Web)
# ==============================================================================
# Google Search Console verification meta tag
# Get from: https://search.google.com/search-console
PUBLIC_GSC_VERIFICATION=your-gsc-token-here
