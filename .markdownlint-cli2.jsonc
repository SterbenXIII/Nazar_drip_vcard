{
  // markdownlint-cli2 config
  // https://github.com/DavidAnson/markdownlint
  "config": {
    "default": true,
    // Allow duplicate headings in different sections
    "MD024": { "siblings_only": true },
    // Allow inline HTML (needed for badges, custom elements)
    "MD033": false,
    // Allow long lines (Prettier handles wrapping)
    "MD013": false,
    // Allow trailing punctuation in headings (e.g. Ukrainian text)
    "MD026": { "punctuation": ".,;:!" },
    // Allow multiple top-level headings (AGENTS.md has sections)
    "MD025": false,
    // Allow non-sequential ordered lists (AGENTS.md uses continuous numbering across subsections)
    "MD029": false,
    // Allow headings without blank lines (MD022)
    "MD022": false,
    // Allow lists without blank lines (MD032)
    "MD032": false,
    // Allow fenced code blocks without language (MD040)
    "MD040": false,
    // Allow table column alignment flexibility (MD060)
    "MD060": false,
    // Allow fenced code blocks without blank lines (MD031)
    "MD031": false,
    // Allow bare URLs (MD034)
    "MD034": false,
  },
  "ignores": [
    "node_modules",
    "dist",
    "**/node_modules",
    "coverage",
    "playwright-report",
    "test-results",
    "blob-report",
    "playwright/.cache",
    "old",
    "venv",
    ".venv",
    "backups",
    "tooling",
    ".corepack-cache",
    ".codex/skills/graphify",
    "graphify-out",
    ".codebase-memory",
    ".tmp",
    "tmp",
    ".secret-scan.*",
    ".trigger-tree",
  ],
}
