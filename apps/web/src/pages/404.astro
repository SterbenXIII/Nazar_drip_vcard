---
import Layout from '../layouts/Layout.astro'
import JsonLd from '../components/JsonLd.astro'
import { seoPages } from '../data/seo-pages'
import { buildWebSiteSchema } from '../utils/schema'
import { siteConfig } from '../config/site'

const webSiteLd = buildWebSiteSchema()
---

<Layout
  title={`Сторінка не знайдена | 404 | ${siteConfig.businessName}`}
  description="На жаль, такої сторінки не існує. Виберіть потрібну послугу або зателефонуйте нам для консультації."
  locale="uk"
>
  <meta name="robots" content="noindex, follow" />

  <main id="main-content" class="error-page" tabindex="-1">
    <div class="container">
      <h1 class="h1">404</h1>
      <p class="subtitle">Упс... Схоже, ви зайшли не туди.</p>

      <div class="cta-box">
        <p>Потрібна термінова допомога?</p>
        <a href={`tel:${siteConfig.phone.raw}`} class="phone-btn">{siteConfig.phone.display}</a>
      </div>

      <div class="services-list">
        <h2>Наші основні послуги:</h2>
        <div class="grid">
          {
            seoPages.map((page) => (
              <a href={`/${page.uk.slug}`} class="link">
                {page.uk.h1}
              </a>
            ))
          }
        </div>
      </div>

      <a href="/" class="back-home">Повернутися на головну</a>
    </div>
  </main>
  <JsonLd schema={webSiteLd} />
</Layout>

<style>
  .error-page {
    padding: clamp(3rem, 10vw, 8rem) 0;
    text-align: center;
    min-height: 90vh;
    display: flex;
    align-items: center;
  }

  .container {
    max-width: 600px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .h1 {
    font-size: clamp(4.5rem, 22vw, 8rem);
    font-weight: 900;
    margin: 0;
    line-height: 1;
    color: var(--md-teal);
  }

  .subtitle {
    font-size: 1.5rem;
    color: var(--md-text);
    margin: 1rem 0 3rem;
  }

  .cta-box {
    background: var(--md-blue-grey);
    border: 1px solid var(--md-border);
    padding: clamp(1.25rem, 5vw, 2rem);
    border-radius: 0.75rem;
    margin-bottom: 3rem;
  }

  .phone-btn {
    display: inline-block;
    background: var(--md-teal);
    color: var(--md-white);
    padding: 1rem 2rem;
    border-radius: 3rem;
    font-weight: 700;
    font-size: 1.25rem;
    text-decoration: none;
    margin-top: 1rem;
    transition: transform 0.2s ease;
  }

  .phone-btn:hover {
    transform: scale(1.05);
  }

  .services-list h2 {
    margin-bottom: 1.5rem;
    color: var(--md-navy);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 0.75rem;
    margin-bottom: 3rem;
  }

  .link {
    color: var(--md-text);
    text-decoration: none;
    padding: 0.5rem;
    border: 1px solid var(--md-border);
    border-radius: 0.5rem;
    font-size: 0.875rem;
  }

  .link:hover {
    color: var(--md-teal);
    border-color: var(--md-teal);
  }

  .back-home {
    color: var(--md-secondary);
    text-decoration: none;
    font-weight: 600;
  }
</style>
