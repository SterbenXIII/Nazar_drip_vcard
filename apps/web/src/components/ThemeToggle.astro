---
const isRussian = Astro.url.pathname.startsWith('/ru')
const darkThemeLabel = isRussian ? 'Включить тёмную тему' : 'Увімкнути темну тему'
const lightThemeLabel = isRussian ? 'Включить светлую тему' : 'Увімкнути світлу тему'
---

<button
  type="button"
  data-theme-toggle
  data-dark-label={darkThemeLabel}
  data-light-label={lightThemeLabel}
  aria-label={darkThemeLabel}
  aria-pressed="false"
  class="theme-toggle"
>
  <span class="icon-sun" aria-hidden="true">☼</span>
  <span class="icon-moon" aria-hidden="true">◐</span>
</button>

<script is:inline>
  ;(() => {
    const root = document.documentElement

    const updateControls = () => {
      const isDark = root.classList.contains('dark')
      document.querySelectorAll('[data-theme-toggle]').forEach((control) => {
        const button = control
        button.setAttribute('aria-pressed', String(isDark))
        button.setAttribute(
          'aria-label',
          isDark
            ? button.dataset.lightLabel || 'Switch to light theme'
            : button.dataset.darkLabel || 'Switch to dark theme',
        )
      })
    }

    if (!window.__vcardThemeToggleBound) {
      document.addEventListener('click', (event) => {
        const target = event.target
        if (!(target instanceof Element)) return
        if (!target.closest('[data-theme-toggle]')) return

        const isDark = !root.classList.contains('dark')
        root.classList.toggle('dark', isDark)
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light')
        } catch {}
        updateControls()
      })
      document.addEventListener('astro:page-load', updateControls)
      window.__vcardThemeToggleBound = true
    }

    updateControls()
  })()
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.875rem;
    height: 2.875rem;
    padding: 0;
    border-radius: 0.875rem;
    border: 1px solid var(--md-control-border);
    background: var(--md-control-bg);
    color: var(--md-control-fg);
    cursor: pointer;
    box-shadow: 0 0.5rem 1rem var(--md-shadow);
    font-size: 1.45rem;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .theme-toggle:hover {
    background: var(--md-control-hover);
    border-color: var(--md-teal);
    transform: translateY(-1px);
  }

  .theme-toggle:active {
    transform: translateY(0) scale(0.96);
  }

  .icon-sun {
    display: none;
  }

  .icon-moon {
    display: inline;
  }

  :global(.dark) .icon-sun {
    display: inline;
  }

  :global(.dark) .icon-moon {
    display: none;
  }
</style>
