---
interface Props {
  terms?: string[]
}

const { terms = [] } = Astro.props
---

{
  terms && terms.length > 0 && (
    <aside
      class="mt-12 py-6 border-t border-gray-100 dark:border-gray-800"
      aria-labelledby="colloquial-heading"
    >
      <div class="max-w-prose">
        <h3
          id="colloquial-heading"
          class="text-sm text-gray-500 dark:text-gray-400 font-normal mb-3"
        >
          Також шукають як:
        </h3>
        <div class="flex flex-wrap gap-x-2 gap-y-1">
          {terms.map((term: string, index: number) => (
            <span class="text-xs text-gray-400 dark:text-gray-500 italic">
              {term}
              {index < terms.length - 1 ? ',' : ''}
            </span>
          ))}
        </div>
      </div>
    </aside>
  )
}
