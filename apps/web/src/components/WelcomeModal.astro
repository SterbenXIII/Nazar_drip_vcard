---
const { phone } = Astro.props
---

<div
  id="welcome-modal"
  class="modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="welcome-title"
  hidden
>
  <div class="modal-panel">
    <div class="modal-content">
      <div class="icon-wrapper">
        <img src="/favicon.svg" alt="Logo" width="64" height="64" />
      </div>
      <h2 id="welcome-title">Вітаємо у Krapelnytsia!</h2>
      <p>
        Професійні медичні послуги у вас вдома. <br />
        Зателефонуйте нам для консультації.
      </p>

      <p class="phone-display">{phone}</p>
      <div class="actions">
        <a href={`tel:${phone}`} class="btn btn-primary"> 📞 Зателефонувати </a>
        <button id="modal-close" class="btn btn-text"> Продовжити перегляд </button>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--md-overlay);
    backdrop-filter: blur(4px);
    display: grid;
    place-items: center;
    padding: 1rem;
    animation: fade-in 0.3s ease-out;
  }

  .modal-backdrop[hidden] {
    display: none;
  }

  .modal-panel {
    background: var(--md-white);
    width: 100%;
    max-width: 24rem;
    border-radius: 1.5rem;
    box-shadow:
      0 10px 15px -3px rgb(0 0 0 / 10%),
      0 4px 6px -4px rgb(0 0 0 / 10%),
      0 0 0 1px rgb(255 255 255 / 10%);
    overflow: hidden;
    animation: slide-up 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .modal-content {
    padding: 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .icon-wrapper {
    width: 5rem;
    height: 5rem;
    background: color-mix(in srgb, var(--md-teal) 10%, transparent);
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
  }

  .icon-wrapper img {
    width: 3.5rem;
    height: 3.5rem;
    object-fit: contain;
  }

  h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--md-navy);
    line-height: 1.2;
  }

  p {
    margin: 0;
    color: var(--md-text);
    font-size: 0.9375rem;
    line-height: 1.6;
    opacity: 0.9;
  }

  .phone-display {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--md-navy);
    margin-top: 0.5rem;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    margin-top: 0.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.5rem;
    border-radius: 1rem;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s;
    border: none;
    width: 100%;
  }

  .btn-primary {
    background: var(--md-teal);
    color: var(--md-on-teal);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--md-teal) 40%, transparent);
  }

  .btn-primary:hover {
    background: color-mix(in srgb, var(--md-teal) 90%, black);
    transform: translateY(-1px);
    box-shadow: 0 6px 16px color-mix(in srgb, var(--md-teal) 50%, transparent);
  }

  .btn-secondary {
    background: color-mix(in srgb, var(--md-navy) 5%, transparent);
    color: var(--md-navy);
  }

  .btn-secondary:hover {
    background: color-mix(in srgb, var(--md-navy) 10%, transparent);
  }

  .btn-text {
    background: transparent;
    color: var(--md-text);
    font-size: 0.875rem;
    padding: 0.5rem;
    opacity: 0.7;
  }

  .btn-text:hover {
    opacity: 1;
    text-decoration: underline;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes slide-up {
    from {
      transform: translateY(20px);
      opacity: 0;
    }

    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  /* High Contrast Mode improvements */
  @media (prefers-contrast: more) {
    .modal-panel {
      border: 2px solid CanvasText;
    }

    .btn {
      border: 2px solid CanvasText;
    }
  }
</style>
<script>
  const KEY = 'vcard:welcome-dismissed'

  document.addEventListener('astro:page-load', () => {
    const modal = document.getElementById('welcome-modal')
    const closeBtn = document.getElementById('modal-close')

    if (!(modal instanceof HTMLElement) || !(closeBtn instanceof HTMLButtonElement)) return
    if (modal.dataset.welcomeReady === 'true') return
    modal.dataset.welcomeReady = 'true'

    let previouslyFocused: HTMLElement | null = null
    let showTimer: ReturnType<typeof setTimeout> | undefined

    const cancelPendingShow = () => {
      if (showTimer === undefined) return
      clearTimeout(showTimer)
      showTimer = undefined
    }

    const dismiss = () => {
      cancelPendingShow()
      modal.hidden = true
      document.documentElement.classList.remove('has-modal')
      try {
        localStorage.setItem(KEY, '1')
      } catch {}
      previouslyFocused?.focus()
    }

    const show = () => {
      if (!modal.isConnected) return
      previouslyFocused =
        document.activeElement instanceof HTMLElement ? document.activeElement : null
      modal.hidden = false
      document.documentElement.classList.add('has-modal')
      closeBtn.focus()
    }

    let isDismissed = false
    try {
      isDismissed = Boolean(localStorage.getItem(KEY))
    } catch {}

    if (!isDismissed) {
      showTimer = setTimeout(() => {
        showTimer = undefined
        show()
      }, 2000)
    }

    document.addEventListener(
      'astro:before-swap',
      () => {
        cancelPendingShow()
        document.documentElement.classList.remove('has-modal')
      },
      { once: true },
    )

    closeBtn.addEventListener('click', dismiss)

    modal.addEventListener('click', (e) => {
      if (e.target === modal) dismiss()
    })

    modal.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        dismiss()
        return
      }

      if (event.key !== 'Tab') return
      const focusable = modal.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
      )
      const first = focusable[0]
      const last = focusable[focusable.length - 1]
      if (!first || !last) return

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault()
        first.focus()
      }
    })
  })
</script>
