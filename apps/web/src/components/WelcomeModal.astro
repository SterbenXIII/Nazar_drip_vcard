---
const { phone } = Astro.props
---

<div
  id="welcome-modal"
  class="modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="welcome-title"
  hidden
>
  <div class="modal-panel">
    <div class="modal-content">
      <div class="icon-wrapper">
        <img src="/favicon.svg" alt="Logo" width="64" height="64" />
      </div>
      <h2 id="welcome-title">Вітаємо у Krapelnytsia!</h2>
      <p>
        Професійні медичні послуги у вас вдома. <br />
        Зателефонуйте нам для консультації або встановіть додаток для швидкого доступу.
      </p>

      <p class="phone-display">{phone}</p>
      <div class="actions">
        <a href={`tel:${phone}`} class="btn btn-primary"> 📞 Зателефонувати </a>
        <button id="install-btn" class="btn btn-secondary" hidden> 📲 Встановити додаток </button>
        <button id="modal-close" class="btn btn-text"> Продовжити перегляд </button>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgb(0 0 0 / 60%);
    backdrop-filter: blur(4px);
    display: grid;
    place-items: center;
    padding: 1rem;
    animation: fadeIn 0.3s ease-out;
  }

  .modal-backdrop[hidden] {
    display: none;
  }

  .modal-panel {
    background: var(--md-white);
    width: 100%;
    max-width: 24rem;
    border-radius: 1.5rem;
    box-shadow:
      0 10px 15px -3px rgb(0 0 0 / 10%),
      0 4px 6px -4px rgb(0 0 0 / 10%),
      0 0 0 1px rgb(255 255 255 / 10%);
    overflow: hidden;
    animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .modal-content {
    padding: 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .icon-wrapper {
    width: 5rem;
    height: 5rem;
    background: color-mix(in srgb, var(--md-teal) 10%, transparent);
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
  }

  .icon-wrapper img {
    width: 3.5rem;
    height: 3.5rem;
    object-fit: contain;
  }

  h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--md-navy);
    line-height: 1.2;
  }

  p {
    margin: 0;
    color: var(--md-text);
    font-size: 0.9375rem;
    line-height: 1.6;
    opacity: 0.9;
  }

  .phone-display {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--md-navy);
    margin-top: 0.5rem;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    margin-top: 0.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.5rem;
    border-radius: 1rem;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s;
    border: none;
    width: 100%;
  }

  .btn-primary {
    background: var(--md-teal);
    color: white;
    box-shadow: 0 4px 12px color-mix(in srgb, var(--md-teal) 40%, transparent);
  }

  .btn-primary:hover {
    background: color-mix(in srgb, var(--md-teal) 90%, black);
    transform: translateY(-1px);
    box-shadow: 0 6px 16px color-mix(in srgb, var(--md-teal) 50%, transparent);
  }

  .btn-secondary {
    background: color-mix(in srgb, var(--md-navy) 5%, transparent);
    color: var(--md-navy);
  }

  .btn-secondary:hover {
    background: color-mix(in srgb, var(--md-navy) 10%, transparent);
  }

  .btn-text {
    background: transparent;
    color: var(--md-text);
    font-size: 0.875rem;
    padding: 0.5rem;
    opacity: 0.7;
  }

  .btn-text:hover {
    opacity: 1;
    text-decoration: underline;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes slide-up {
    from {
      transform: translateY(20px);
      opacity: 0;
    }

    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  /* High Contrast Mode improvements */
  @media (prefers-contrast: more) {
    .modal-panel {
      border: 2px solid CanvasText;
    }

    .btn {
      border: 2px solid CanvasText;
    }
  }
</style>
<script>
  const KEY = 'vcard:welcome-dismissed'
  let deferredPrompt: BeforeInstallPromptEvent | null = null
  let isInstallHandled = false // permanent lock — prevents any re-show after first click

  const isFirefox = navigator.userAgent.includes('Firefox')

  // Capture beforeinstallprompt ASAP — Chrome/Edge only, Firefox never fires this
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault()
    if (isInstallHandled) return // ignore if user already clicked
    deferredPrompt = e as BeforeInstallPromptEvent
    console.log('[PWA] beforeinstallprompt captured')
    const btn = document.getElementById('install-btn')
    if (btn) btn.hidden = false
  })

  // Hide install button if app is already installed
  window.addEventListener('appinstalled', () => {
    console.log('[PWA] App installed successfully')
    deferredPrompt = null
    isInstallHandled = true
    const btn = document.getElementById('install-btn')
    if (btn) btn.hidden = true
  })

  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('welcome-modal')
    const closeBtn = document.getElementById('modal-close')
    const installBtn = document.getElementById('install-btn') as HTMLButtonElement | null
    const actionsDiv = installBtn?.parentElement

    if (!modal || !closeBtn) return

    // Firefox: no beforeinstallprompt — show a static hint in place of the button
    if (isFirefox && actionsDiv && installBtn) {
      installBtn.hidden = true
      const firefoxTip = document.createElement('p')
      firefoxTip.id = 'install-tip'
      firefoxTip.style.cssText =
        'font-size:0.8rem;color:var(--md-text);margin-top:0.5rem;opacity:0.8;text-align:center'
      firefoxTip.textContent = 'У Firefox: натисніть іконку 🏠 в адресному рядку → «Встановити»'
      installBtn.insertAdjacentElement('afterend', firefoxTip)
    }

    // If beforeinstallprompt already fired before DOMContentLoaded, show button
    if (deferredPrompt && installBtn && !isInstallHandled) {
      installBtn.hidden = false
    }

    // Show modal if not dismissed
    if (!localStorage.getItem(KEY)) {
      setTimeout(() => {
        modal.hidden = false
      }, 2000)
    }

    // Install button handler
    installBtn?.addEventListener('click', async () => {
      if (isInstallHandled) return // extra guard
      isInstallHandled = true // lock permanently
      installBtn.hidden = true // hide immediately — prevents any re-show

      if (!deferredPrompt) {
        showManualInstallTip()
        return
      }
      deferredPrompt.prompt()
      const { outcome } = await deferredPrompt.userChoice
      console.log('[PWA] Install prompt outcome:', outcome)
      deferredPrompt = null
    })

    // Idempotent tip — can only exist once in the DOM
    function showManualInstallTip() {
      if (document.getElementById('install-tip')) return // guard against duplicates
      const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent)
      const tip = document.createElement('p')
      tip.id = 'install-tip'
      tip.style.cssText =
        'font-size:0.8rem;color:var(--md-text);margin-top:0.5rem;opacity:0.8;text-align:center'
      tip.textContent = isIOS
        ? 'На iOS: натисніть Share → «На екран «Додому»»'
        : 'У браузері: меню ⋮ → «Встановити застосунок»'
      installBtn?.insertAdjacentElement('afterend', tip)
    }

    // Close button
    closeBtn.addEventListener('click', () => {
      modal.hidden = true
      try {
        localStorage.setItem(KEY, '1')
      } catch {}
    })

    // Close on backdrop click
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.hidden = true
        try {
          localStorage.setItem(KEY, '1')
        } catch {}
      }
    })
  })
</script>
