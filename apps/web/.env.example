# ==============================================================================
# @vcard/web — Environment Variables
# ==============================================================================
# Copy to .env and fill in values for production.

# Google Search Console verification meta tag (optional)
PUBLIC_GSC_VERIFICATION=your_gsc_verification_code_here

# Cloudflare Turnstile site key (public, used in ContactForm)
# Get from: https://dash.cloudflare.com → Turnstile → Add Site
# Leave empty to use the always-pass test key in development
PUBLIC_TURNSTILE_SITE_KEY=
