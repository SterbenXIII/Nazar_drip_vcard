{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@vcard/web",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate:build": "tsx scripts/validate-build.ts",
    "audit:seo": "tsx src/scripts/seo-audit.ts",
    "postbuild": "tsx src/scripts/seo-audit.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:lhci": "pnpx @lhci/cli autorun",
    "test:lhci:all": "node scripts/lhci-all.js"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.0",
    "@resvg/resvg-js": "2.6.0",
    "@vcard/shared": "workspace:*",
    "astro": "7.3.1",
    "satori": "0.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@csstools/postcss-global-data": "4.0.0",
    "@playwright/test": "1.58.2",
    "@types/node": "25.3.1",
    "@typescript-eslint/parser": "8.68.0",
    "astro-eslint-parser": "1.2.2",
    "eslint-plugin-astro": "1.5.0",
    "postcss": "8.5.18",
    "postcss-calc": "10.1.1",
    "postcss-combine-duplicated-selectors": "10.0.3",
    "postcss-custom-media": "12.0.1",
    "postcss-font-display": "0.3.0",
    "postcss-preset-env": "11.2.0",
    "postcss-pxtorem": "6.1.0",
    "postcss-sort-media-queries": "5.2.0",
    "tsx": "4.19.0"
  },
  "engines": {
    "node": ">=24"
  }
}
