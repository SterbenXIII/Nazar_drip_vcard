# ==============================================================================
# @vcard/api — Environment Variables
# ==============================================================================
# Copy to .env and fill in values. See src/config/env.config.ts for Zod schema.

# ---------- Core ----------
NODE_ENV=production
BACKEND_PORT=5678
DOMAIN_NAME=krapelnytsia.lviv.ua

# ---------- Telegram Bot ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_MASTER_ID=
# Comma-separated chat IDs for lead notifications (optional)
TELEGRAM_NOTIFY_IDS=

# ---------- Email (Gmail OAuth2) ----------
SMTP_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
ADMIN_EMAIL=

# ---------- Notification Providers ----------
# Comma-separated: TELEGRAM,EMAIL
ENABLED_PROVIDERS=TELEGRAM

# ---------- Security ----------
WEBHOOK_SECRET=
