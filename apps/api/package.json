{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@vcard/api",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.js --external:better-sqlite3 --external:nodemailer --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "1.19.15",
    "@hono/zod-validator": "0.7.6",
    "@vcard/shared": "workspace:*",
    "better-sqlite3": "12.6.2",
    "dotenv": "17.2.4",
    "hono": "4.12.34",
    "nodemailer": "9.1.0",
    "pino": "10.3.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.4.0",
    "@types/node": "25.2.2",
    "@types/nodemailer": "8.0.1",
    "esbuild": "0.27.3",
    "pino-pretty": "13.1.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "package.json",
    "allowed_chats.json"
  ]
}
