---
import { consultationCta, mainSiteCta } from '../content/customer-materials'
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title">Інформація про заклад і напрями допомоги</h1>
      <p class="lead">
        Тут буде короткий вступ із погодженого опису закладу. Зараз показано тільки ієрархію та
        стиль подачі.
      </p>
      <div class="hero-actions">
        <div class="hero-action-group">
          <a
            class="button"
            href={consultationCta.href}
            aria-label="Безкоштовна консультація телефоном"
          >
            {consultationCta.label}
          </a>
          <small class="hero-action-note">{consultationCta.publicationNote}</small>
        </div>
        <div class="hero-action-group">
          <span class="button secondary main-site-unavailable">{mainSiteCta.label}</span>
          <small class="hero-action-note">{mainSiteCta.missingUrlNote}</small>
        </div>
      </div>
    </div>
    <div class="hero-geometry" aria-hidden="true"><span></span></div>
  </div>
</section>
