---
import Turnstile from './Turnstile.astro'
import { hotline, telegram } from '../content/customer-materials'

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap contact-grid">
    <div class="contact-copy">
      <h2 id="contact-title">Звернення</h2>
      <p>
        Перелік напрямів і географія роботи ще не підтверджені. Тому форму не можна надіслати до
        появи погоджених значень.
      </p>
      <dl class="contact-methods">
        <div>
          <dt>Гаряча лінія</dt>
          <dd>
            <a
              href={hotline.href}
              aria-label={`Зателефонувати на гарячу лінію: ${hotline.display}`}
            >
              {hotline.display}
            </a>
          </dd>
        </div>
        <div>
          <dt>{telegram.label}</dt>
          <dd><a href={telegram.href} aria-label={telegram.accessibleName}>{telegram.label}</a></dd>
        </div>
      </dl>
    </div>
    <form id="clinic-lead-form" data-clinic-ready="false" novalidate>
      <input type="hidden" name="source" value="clinic-web" />

      <div class="field">
        <label for="clinic-name">Ваше ім'я</label>
        <input
          id="clinic-name"
          name="name"
          type="text"
          autocomplete="name"
          aria-describedby="name-error"
        />
        <p id="name-error" class="field-error" aria-live="polite"></p>
      </div>

      <div class="field">
        <label for="clinic-phone">Номер телефону</label>
        <input
          id="clinic-phone"
          name="phone"
          type="tel"
          inputmode="tel"
          autocomplete="tel"
          placeholder="+380..."
          aria-describedby="phone-error"
        />
        <p id="phone-error" class="field-error" aria-live="polite"></p>
      </div>

      <fieldset aria-describedby="clinic-services-empty services-error clinic-product-status">
        <legend>Напрям звернення</legend>
        <p id="clinic-services-empty" class="empty-state">
          Напрями будуть додані після погодження.
        </p>
        <p id="services-error" class="field-error" aria-live="polite"></p>
      </fieldset>

      <div class="field">
        <label for="clinic-district">Територія звернення</label>
        <select
          id="clinic-district"
          name="district"
          disabled
          aria-describedby="district-error clinic-product-status"
        >
          <option value="">Територію буде додано після погодження</option>
        </select>
        <p id="district-error" class="field-error" aria-live="polite"></p>
      </div>

      {turnstileSiteKey && <Turnstile siteKey={turnstileSiteKey} />}

      <p id="clinic-product-status" class="form-status" role="status" aria-live="polite">
        Відправлення тимчасово недоступне: потрібні погоджені напрями та територія.
      </p>
      <p id="clinic-request-status" class="form-status" role="status" aria-live="polite"></p>
      <button type="submit" id="clinic-submit" aria-describedby="clinic-product-status" disabled
        >Надіслати звернення</button
      >
    </form>
  </div>
</section>

<script src="../scripts/clinic-lead-form.ts"></script>

<style>
  form {
    display: grid;
    gap: 0.8125rem;
    padding: 1.6875rem;
    border-radius: 0.9375rem;
    background: var(--surface);
  }

  .field,
  fieldset {
    display: grid;
    gap: 0.4375rem;
  }

  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }

  label,
  legend {
    color: var(--text);
    font-size: var(--font-label);
    font-weight: 700;
  }

  input,
  select,
  button {
    font: inherit;
  }

  .field input,
  .field select {
    width: 100%;
    min-width: 0;
    min-height: 2.6875rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid #cbdedf;
    border-radius: 0.4375rem;
    background: var(--surface);
    color: #45616b;
    font-size: 0.875rem;
  }

  .field select:disabled {
    color: #667f88;
  }

  .service-option {
    display: flex;
    width: fit-content;
    align-items: flex-start;
    gap: 0.625rem;
    line-height: 1.5;
  }

  .service-option input[type='checkbox'] {
    width: 1.125rem;
    height: 1.125rem;
    min-height: 1.125rem;
    flex: 0 0 1.125rem;
    margin: 0.2rem 0 0;
    padding: 0;
    accent-color: var(--primary);
  }

  .empty-state {
    margin: 0;
    padding: 0.625rem 0.75rem;
    border-left: 3px solid #b6d9d7;
    background: var(--surface-muted);
    color: var(--text-muted);
    font-size: var(--font-help);
  }

  .field-error,
  .form-status {
    margin: 0;
    font-size: var(--font-help);
    line-height: 1.5;
  }

  .contact-methods {
    display: grid;
    gap: 0.75rem;
    margin: 1.5rem 0 0;
  }

  .contact-methods div {
    display: grid;
    gap: 0.25rem;
  }

  .contact-methods dt {
    color: #cfe3e4;
    font-size: var(--font-label);
    font-weight: 700;
  }

  .contact-methods dd {
    margin: 0;
  }

  .contact-methods a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: #fff;
    text-underline-offset: 0.2em;
  }

  .field-error,
  #clinic-request-status[data-state='error'] {
    color: var(--error);
  }

  .field-error:empty {
    display: none;
  }

  .form-status {
    color: var(--text-muted);
  }

  #clinic-request-status[data-state='success'] {
    color: var(--success);
  }

  button {
    min-height: 2.75rem;
    padding: 0.75rem 1.375rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--primary);
    color: var(--primary-foreground);
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 700;
  }

  button:hover:not(:disabled) {
    background: var(--primary-hover);
  }

  button:disabled {
    border: 1px solid #aabfc3;
    background: var(--disabled-background);
    color: var(--disabled-text);
    cursor: not-allowed;
  }

  @media (width <= 700px) {
    form {
      padding: 1.25rem;
    }
  }
</style>
