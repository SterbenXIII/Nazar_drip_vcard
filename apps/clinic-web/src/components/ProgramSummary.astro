---
import { landingSections } from '../content/landing'

const copy = landingSections[4]
const detailRoutesAvailable = (process.env.CLINIC_SITE_MODE ?? 'normal') !== 'normal'
---

<section class="landing-section program" id="program" aria-labelledby="program-title">
  <div class="wrap editorial-grid">
    <div class="section-intro">
      <p class="section-kicker">Програми</p>
      <h2 id="program-title">{copy.title}</h2>
      <p>
        Програма може включати різні форми роботи. Її наповнення залежить від потреб людини й
        узгодженого формату.
      </p>
      {
        detailRoutesAvailable && (
          <a class="text-link" href="/programa/">
            Як побудована програма <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
    <ul class="editorial-list" aria-label="Напрями програми підтримки">
      <li>
        <h3>Індивідуальна та групова робота</h3><p>
          Зміст і доступність цих форм можна уточнити під час консультації.
        </p>
      </li>
      <li>
        <h3>Підтримка близьких</h3><p>
          Рідні можуть обговорити власні запитання та можливу участь у підтримці.
        </p>
      </li>
      <li>
        <h3>Соціалізація та ресоціалізація</h3><p>
          У стаціонарній програмі передбачені етапи реабілітації, ресоціалізації та соціалізації.
        </p>
      </li>
    </ul>
  </div>
</section>

<style>
  .landing-section.program {
    background: #e8efeb;
  }

  .program .editorial-grid {
    grid-template-columns: minmax(15rem, 0.8fr) minmax(0, 1.8fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .program .section-kicker {
    margin-bottom: 0.65rem;
    color: #08717a;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .program .editorial-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 0.75rem;
  }

  .program .editorial-list li,
  .program .editorial-list li:last-child {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border: 1px solid rgb(11 48 42 / 12%);
    border-top: 3px solid #8adce6;
    border-radius: 1rem;
    background: rgb(255 255 255 / 58%);
  }

  .program .editorial-list h3 {
    margin-bottom: 0;
    font-size: clamp(1.05rem, 1.3vw, 1.25rem);
    line-height: 1.2;
  }

  .program .editorial-list p {
    margin-bottom: 0;
    font-size: 0.9375rem;
  }

  .program .section-intro .text-link {
    padding: 0.7rem 1rem;
    border: 1px solid #0b302a;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .program .section-intro .text-link:hover {
    background: #0b302a;
    color: #f7f5ec;
  }

  .program .section-intro .text-link:focus-visible {
    outline: 3px solid #08717a;
    outline-offset: 3px;
  }

  @media (width <= 900px) {
    .program .editorial-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  @media (width <= 700px) {
    .program .editorial-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
