---
interface Props {
  hrefPrefix?: string
  homeHref?: string
  landing?: boolean
  overlay?: boolean
}

const { hrefPrefix = '', homeHref = '/', landing = false, overlay = false } = Astro.props
import { consultationCta, hotline, telegram } from '../content/customer-materials'

const supportingPagesAvailable = (process.env.CLINIC_SITE_MODE ?? 'normal') !== 'normal'
const navigation = supportingPagesAvailable
  ? [
      { href: '/programa/', label: 'Програма' },
      { href: '/umovy/', label: 'Про центр' },
      { href: '/rodyni/', label: 'Для родини' },
      { href: '/napriamy/', label: 'Напрями' },
    ]
  : [
      { href: `${hrefPrefix}#conditions`, label: 'Про центр' },
      { href: `${hrefPrefix}#dependencies`, label: 'Напрями' },
      { href: `${hrefPrefix}#process`, label: 'Як звернутися' },
      { href: `${hrefPrefix}#family`, label: 'Для родини' },
    ]
---

<header
  class:list={['site-header', overlay && 'site-header-overlay', landing && 'site-header-landing']}
>
  <div class="wrap header-row">
    <a class="identity" href={homeHref} aria-label="HAVENHUB — головна">
      {
        landing && (
          <svg class="identity-mark" viewBox="0 0 96 96" aria-hidden="true" focusable="false">
            <text x="5" y="82" fill="currentColor" font-family="Georgia, serif" font-size="96">
              H
            </text>
            <path
              d="M5 56c18-8 26-24 42-23 17 1 21 20 44 5"
              fill="none"
              stroke="#8bdce6"
              stroke-linecap="round"
              stroke-width="8"
            />
          </svg>
        )
      }
      <span class="identity-copy">
        <span class="identity-name">HAVENHUB</span>
        {landing && <span class="identity-descriptor">Центр допомоги</span>}
      </span>
    </a><nav class="desktop-nav" aria-label="Основна навігація">
      {navigation.map(({ href, label }) => <a href={href}>{label}</a>)}
    </nav><a
      class="header-action"
      href={consultationCta.href}
      aria-label="Зателефонувати на гарячу лінію"
    >
      {consultationCta.label}
    </a>
    <button
      class="mobile-menu-toggle"
      id="mobile-menu-toggle"
      type="button"
      aria-label="Меню навігації"
      aria-controls="mobile-navigation"
      aria-expanded="false"
    >
      <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
    <nav id="mobile-navigation" class="mobile-navigation" aria-label="Мобільна навігація" hidden>
      {navigation.map(({ href, label }) => <a href={href}>{label}</a>)}
      <a href={`${hrefPrefix}#contact`}>Звернення</a>
      <a href={hotline.href} aria-label={`Зателефонувати на гарячу лінію: ${hotline.display}`}
        >{hotline.display}</a
      >
      <a href={telegram.href} aria-label={telegram.accessibleName}>{telegram.label}</a>
    </nav>
  </div>
</header>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>('#mobile-menu-toggle')
  const mobileNavigation = document.querySelector<HTMLElement>('#mobile-navigation')
  const identity = document.querySelector<HTMLAnchorElement>('.site-header .identity')
  const desktopNavigation = document.querySelector<HTMLElement>('.desktop-nav')
  const headerAction = document.querySelector<HTMLAnchorElement>('.header-action')
  const desktopBreakpoint = window.matchMedia('(min-width: 1081px)')
  let desktopHeaderHadFocus = false

  const setMenuOpen = (open: boolean) => {
    if (!menuToggle || !mobileNavigation) return
    menuToggle.setAttribute('aria-expanded', String(open))
    mobileNavigation.hidden = !open
  }

  menuToggle?.addEventListener('click', () => {
    setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true')
  })

  document.addEventListener('focusin', (event) => {
    desktopHeaderHadFocus = Boolean(
      desktopNavigation?.contains(event.target as Node) || event.target === headerAction,
    )
  })

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || menuToggle?.getAttribute('aria-expanded') !== 'true') return
    setMenuOpen(false)
    menuToggle.focus()
  })

  mobileNavigation?.addEventListener('click', (event) => {
    const link = (event.target as Element).closest('a')
    if (!link) return

    setMenuOpen(false)
    const targetUrl = new URL(link.href)
    if (targetUrl.origin !== location.origin || targetUrl.pathname !== location.pathname) return

    const target = document.getElementById(decodeURIComponent(targetUrl.hash.slice(1)))
    if (!target) return
    target.tabIndex = -1
    target.focus({ preventScroll: true })
  })

  desktopBreakpoint.addEventListener('change', ({ matches }) => {
    if (matches) {
      const menuWasOpen = menuToggle?.getAttribute('aria-expanded') === 'true'
      const focusIsInMobileHeader =
        mobileNavigation?.contains(document.activeElement) || document.activeElement === menuToggle
      setMenuOpen(false)
      if (menuWasOpen || focusIsInMobileHeader) identity?.focus()
      return
    }

    if (
      desktopHeaderHadFocus ||
      desktopNavigation?.contains(document.activeElement) ||
      document.activeElement === headerAction
    ) {
      desktopHeaderHadFocus = false
      identity?.focus()
    }
  })
</script>

<style>
  .site-header-landing .header-row {
    min-height: 7rem;
  }

  .site-header-landing .identity {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 1.8vw, 1.75rem);
  }

  .site-header-landing .identity-mark {
    width: clamp(3.5rem, 6vw, 5.75rem);
    height: clamp(3.5rem, 6vw, 5.75rem);
    flex: 0 0 auto;
  }

  .site-header-landing .identity-copy {
    display: grid;
    gap: 0.5rem;
  }

  .site-header-landing .identity-name {
    color: #f4f7f2;
    font-size: clamp(2rem, 3.8vw, 3.625rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .site-header-landing .identity-descriptor {
    color: #b9e9ed;
    font-size: 0.8125rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .site-header-landing .desktop-nav,
  .site-header-landing .header-action,
  .site-header-landing .mobile-menu-toggle,
  .site-header-landing .mobile-navigation {
    display: none;
  }

  @media (width <= 900px) {
    .site-header-landing .header-row {
      min-height: 6rem;
    }

    .site-header-landing .identity-mark {
      width: 3.5rem;
      height: 3.5rem;
    }

    .site-header-landing .identity-name {
      font-size: clamp(1.75rem, 8vw, 2.5rem);
    }
  }
</style>
