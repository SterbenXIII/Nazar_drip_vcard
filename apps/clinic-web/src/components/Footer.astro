---
import { hotline, telegram } from '../content/customer-materials'

interface Props {
  homeHref?: string
  hideContactsOnMobile?: boolean
}

const { homeHref = '/', hideContactsOnMobile = false } = Astro.props
const supportingPagesAvailable = (process.env.CLINIC_SITE_MODE ?? 'normal') !== 'normal'
const navigation = supportingPagesAvailable
  ? [
      { href: '/programa/', label: 'Програма' },
      { href: '/umovy/', label: 'Про центр' },
      { href: '/rodyni/', label: 'Для родини' },
      { href: '/napriamy/', label: 'Напрями' },
    ]
  : []
---

<footer class:list={['footer', hideContactsOnMobile && 'footer--hide-contacts-mobile']}>
  <div class="wrap">
    <a class="identity" href={homeHref} aria-label="HAVENHUB — головна">HAVENHUB</a>
    {
      navigation.length > 0 && (
        <nav class="footer-navigation" aria-label="Навігація внизу сторінки">
          {navigation.map(({ href, label }) => (
            <a href={href}>{label}</a>
          ))}
        </nav>
      )
    }
    <div class="footer-contacts" aria-label="Контакти HAVENHUB">
      <a href={hotline.href} aria-label={`Зателефонувати на гарячу лінію: ${hotline.display}`}>
        {hotline.display}
      </a>
      <a href={telegram.href} aria-label={telegram.accessibleName}>{telegram.label}</a>
    </div>
  </div>
</footer>

<style>
  @media (width <= 700px) {
    .footer--hide-contacts-mobile .footer-contacts {
      display: none;
    }
  }
</style>
