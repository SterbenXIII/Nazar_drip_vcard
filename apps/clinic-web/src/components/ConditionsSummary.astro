---
import StagingIllustration from './StagingIllustration.astro'
import { resolveStagingIllustration } from '../content/staging-media.mjs'

const siteMode = process.env.CLINIC_SITE_MODE ?? 'normal'
const detailRoutesAvailable = siteMode !== 'normal'
const hasConditionsVisual =
  siteMode !== 'staging' || resolveStagingIllustration('IMG_0905', siteMode) !== null
---

<section class="landing-section conditions" id="conditions" aria-labelledby="conditions-title">
  <div
    class:list={['wrap conditions-layout', !hasConditionsVisual && 'conditions-layout-text-only']}
  >
    {
      hasConditionsVisual && (
        <div class="conditions-visual">
          {siteMode === 'staging' ? (
            <StagingIllustration slot="IMG_0905" />
          ) : (
            <figure class="conditions-photo">
              <img
                src="/havenhub-lounge-v2.jpg"
                alt="Ілюстративне зображення світлої вітальні з панорамними вікнами та рослинами"
                loading="lazy"
                decoding="async"
                width="1536"
                height="1024"
              />
              <figcaption>Візуалізація інтер’єру, не фото приміщення HAVENHUB</figcaption>
            </figure>
          )}
        </div>
      )
    }

    <div class="section-intro conditions-intro">
      <p class="eyebrow">Про центр</p>
      <h2 id="conditions-title">Простір і щоденні умови</h2>
      <p>
        Центр розташований у Львівській області. Конкретні умови перебування варто уточнити для
        обраної програми.
      </p>
      {
        detailRoutesAvailable && (
          <a class="text-link" href="/umovy/">
            Дізнатися більше про центр <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>

    <div class="conditions-facts">
      <ul class="conditions-fact-list">
        <li>
          <span class="conditions-fact-marker" aria-hidden="true"></span>Чотириразове харчування
        </li>
        <li><span class="conditions-fact-marker" aria-hidden="true"></span>Спортзал і сауна</li>
        <li><span class="conditions-fact-marker" aria-hidden="true"></span>Ігрові зони</li>
        <li><span class="conditions-fact-marker" aria-hidden="true"></span>Групове дозвілля</li>
      </ul>
      <p class="conditions-note">
        Актуальність і доступність окремих можливостей уточнюють під час консультації.
      </p>
    </div>
  </div>
</section>
