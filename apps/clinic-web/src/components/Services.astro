---
import { Image } from 'astro:assets'
import consultationPhoto from '../assets/care-formats/consultation.png'
import residentialPhoto from '../assets/care-formats/residential.png'
import homeVisitPhoto from '../assets/care-formats/home-visit.png'
import { careFormats, dependencyTypes } from '../content/customer-materials'
import { landingSections } from '../content/landing'

const detailRoutesAvailable =
  import.meta.env.DEV || (process.env.CLINIC_SITE_MODE ?? 'normal') !== 'normal'
const dependencyDescriptions = [
  'Починаємо з оцінювання фізичного й психологічного стану та індивідуального плану допомоги.',
  'Підтримка з урахуванням ігрової залежності та індивідуальних потреб.',
  'Враховуємо фізичний стан, психологічне благополуччя й ризики припинення вживання.',
]
const dependencyImages = [
  '/havenhub-alcohol-dependency.jpg',
  '/havenhub-gambling-dependency.jpg',
  '/havenhub-narcotic-dependency.jpg',
]
const formatCards = [
  {
    id: 'outpatient',
    title: careFormats[1],
    description:
      'Зустрічі без постійного перебування у центрі. Зміст програми уточнюють під час звернення.',
    linkLabel: 'Про амбулаторну програму',
    image: consultationPhoto,
    alt: 'Розмова чоловіка з фахівчинею під час консультації',
    href: detailRoutesAvailable ? '/napriamy/#care-format-outpatient' : '/site/#clinic-lead-form',
  },
  {
    id: 'residential',
    title: careFormats[0],
    description:
      'Програма з перебуванням у центрі. Умови та зміст обговорюють під час консультації.',
    linkLabel: 'Про стаціонарну програму',
    image: residentialPhoto,
    alt: 'Світла кімната центру з ліжком і місцем для відпочинку',
    href: detailRoutesAvailable ? '/napriamy/#care-format-residential' : '/site/#clinic-lead-form',
  },
  {
    id: 'home-visit',
    title: 'Допомога вдома',
    description:
      'Виїзд додому у Львові та Львівській області. Можливість і умови уточнюють під час звернення.',
    linkLabel: 'Про допомогу вдома',
    image: homeVisitPhoto,
    alt: 'Медичний фахівець із сумкою прямує до автомобіля',
    href: detailRoutesAvailable ? '/napriamy/#care-format-home-visit' : '/site/#clinic-lead-form',
  },
]
---

<section
  class="landing-section dependencies"
  id="dependencies"
  aria-labelledby="dependencies-title"
>
  <div class="wrap editorial-grid">
    <div class="section-intro">
      <p class="section-kicker">Наші напрями допомоги</p>
      <h2 id="dependencies-title">{landingSections[2].title}</h2>
      <p>{landingSections[2].introduction}</p>
      <a class="text-link" href="#formats">
        Формати допомоги <span aria-hidden="true">→</span>
      </a>
    </div>
    <ul class="editorial-list">
      {
        dependencyTypes.map((name, index) => (
          <li>
            <>
              <span class="direction-icon" aria-hidden="true">
                {index === 0 ? (
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M16 3 5 7.5v8.3c0 5.6 4.2 10.2 11 13.2 6.8-3 11-7.6 11-13.2V7.5L16 3Z" />
                    <path d="M16 11v9m-4.5-4.5h9" />
                  </svg>
                ) : index === 1 ? (
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M16 5.5c-1.7-2.7-5.6-2.1-6.2.9-3.5-.6-6.3 2.5-4.6 5.6-2.4 2.1-1.4 5.8 1.4 6.3-.6 3.1 2.1 5.9 5.3 4.8 1 .8 2.6 1.2 4.1.7V5.5Z" />
                    <path d="M16 5.5c1.7-2.7 5.6-2.1 6.2.9 3.5-.6 6.3 2.5 4.6 5.6 2.4 2.1 1.4 5.8-1.4 6.3.6 3.1-2.1 5.9-5.3 4.8-1 .8-2.6 1.2-4.1.7V5.5Z" />
                    <path d="M11 11.5c2 0 3 1.2 3 3m7-3c-2 0-3 1.2-3 3M11 18h3m7 0h-3" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M27 5C15.2 5.2 7 9.1 7 17c0 6.2 6.2 9.2 11.4 5.1C23.4 18.3 26 11.4 27 5Z" />
                    <path d="M5 27c3.2-5.1 8.3-10 16.1-15.4M5.5 18c-2.3-1.5-3.2-4-3.2-7 4.4 0 7.8 1.1 9.5 3.7" />
                  </svg>
                )}
              </span>
              <h3>{name}</h3>
              <p>{dependencyDescriptions[index]}</p>
              <img class="direction-image" src={dependencyImages[index]} alt="" loading="lazy" />
            </>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="landing-section formats" id="formats" aria-labelledby="formats-title">
  <div class="wrap">
    <div class="format-heading">
      <h2 id="formats-title">Оберіть зручний формат підтримки</h2>
      <p>Можливість і умови участі обговорюються з фахівцем</p>
    </div>
    <ul class="format-cards">
      {
        formatCards.map((card) => (
          <li class:list={['format-card', `format-card--${card.id}`]}>
            <Image class="format-photo" src={card.image} alt={card.alt} />
            <div class="format-card-copy">
              <h3>{card.title}</h3>
              <p>{card.description}</p>
              <a class="text-link" href={card.href}>
                {card.linkLabel}
              </a>
            </div>
          </li>
        ))
      }
    </ul>
    <div class="format-contact">
      <p>Потрібна допомога з вибором?</p>
      <a class="button" href="/site/#clinic-lead-form">Обговорити формати</a>
    </div>
  </div>
</section>

<style>
  .format-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(15rem, 0.9fr);
    align-items: end;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .format-heading h2 {
    max-width: 18ch;
    margin: 0;
  }

  .format-heading p {
    max-width: 38ch;
    margin: 0 0 0.35rem;
    color: #435852;
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .format-cards {
    display: grid;
    grid-template-columns: minmax(0, 1.22fr) minmax(0, 1fr);
    grid-template-rows: repeat(2, minmax(13rem, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .format-card {
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    overflow: hidden;
    border: 1px solid rgb(11 48 42 / 10%);
    border-radius: var(--radius-lg);
    background: #fff;
  }

  .format-card--outpatient {
    grid-column: 1;
    grid-row: 1 / span 2;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
  }

  .format-photo {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 13rem;
    object-fit: cover;
  }

  .format-card--outpatient .format-photo {
    object-position: 50% 34%;
  }

  .format-card--residential .format-photo {
    object-position: 50% 48%;
  }

  .format-card--home-visit .format-photo {
    object-position: 62% 54%;
  }

  .format-card-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(1rem, 2.3vw, 2rem);
  }

  .format-card-copy h3 {
    margin: 0 0 0.75rem;
    color: #0b302a;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    font-weight: 600;
    line-height: 1.2;
  }

  .format-card-copy p {
    max-width: 38ch;
    margin: 0 0 0.75rem;
    color: #354943;
    font-size: 1rem;
    line-height: 1.55;
  }

  .format-card-copy .text-link {
    margin-top: auto;
    font-size: 0.9375rem;
  }

  .format-card--outpatient .format-card-copy {
    padding: clamp(1.25rem, 2.5vw, 2.25rem);
    background: #0b302a;
    color: #f7f5ec;
  }

  .format-card--outpatient .format-card-copy h3,
  .format-card--outpatient .format-card-copy p,
  .format-card--outpatient .format-card-copy .text-link {
    color: #f7f5ec;
  }

  .format-card--outpatient .format-card-copy h3 {
    font-size: clamp(1.4rem, 2.5vw, 2.25rem);
  }

  .format-card--outpatient .format-card-copy .text-link:focus-visible {
    outline-color: #b9e9ed;
  }

  .format-contact {
    display: flex;
    min-height: 5.5rem;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.25rem;
    padding: 1rem clamp(1rem, 3vw, 2rem);
    border-radius: var(--radius-lg);
    background: #e5f1eb;
  }

  .format-contact p {
    min-width: 0;
    margin: 0;
    color: #0b302a;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 600;
  }

  .format-contact .button {
    min-height: 2.75rem;
    flex: 0 1 auto;
  }

  .format-card-copy a:focus-visible,
  .format-contact a:focus-visible {
    outline: 3px solid #08717a;
    outline-offset: 3px;
  }

  @media (width <= 900px) {
    .format-heading {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }

    .format-cards {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
    }

    .format-card--outpatient {
      grid-column: auto;
      grid-row: auto;
      grid-template-columns: minmax(0, 1fr);
    }

    .format-card--outpatient .format-photo {
      aspect-ratio: 16 / 10;
    }
  }

  @media (width <= 600px) {
    .format-heading {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
    }

    .format-heading h2 {
      max-width: 16ch;
    }

    .format-card:not(.format-card--outpatient) {
      grid-template-columns: minmax(5.5rem, 0.34fr) minmax(0, 0.66fr);
    }

    .format-card:not(.format-card--outpatient) .format-photo {
      min-height: 8.5rem;
    }

    .format-card-copy {
      padding: 0.8rem;
    }

    .format-card-copy h3 {
      margin-bottom: 0.35rem;
      font-size: 1.125rem;
    }

    .format-card-copy p {
      margin-bottom: 0.25rem;
      font-size: 0.875rem;
      line-height: 1.4;
    }

    .format-card-copy .text-link {
      min-height: 2.5rem;
      font-size: 0.8125rem;
      line-height: 1.3;
    }

    .format-contact {
      align-items: flex-start;
      flex-direction: column;
      padding: 1rem;
    }

    .format-contact .button {
      width: 100%;
    }
  }
</style>
