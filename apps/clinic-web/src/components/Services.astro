---
import { careFormats, dependencyTypes } from '../content/customer-materials'
import { landingSections } from '../content/landing'

const detailRoutesAvailable = (process.env.CLINIC_SITE_MODE ?? 'normal') !== 'normal'
const dependencyDescriptions = [
  'Під час першого звернення можна описати ситуацію й запитати про доступні кроки допомоги.',
  'Можна звернутися щодо власних труднощів або запитати, як підтримати близьку людину.',
  'Формат підтримки обговорюють після уточнення обставин і стану людини.',
]
const formatDescriptions = [
  'Програму з перебуванням у центрі обговорюють під час консультації.',
  'Амбулаторну програму обговорюють окремо від виїзду додому.',
  'Виїзд додому у Львові та Львівській області.',
]
---

<section
  class="landing-section dependencies"
  id="dependencies"
  aria-labelledby="dependencies-title"
>
  <div class="wrap editorial-grid">
    <div class="section-intro">
      <h2 id="dependencies-title">{landingSections[2].title}</h2>
      <p>{landingSections[2].introduction}</p>
    </div>
    <ul class="editorial-list">
      {
        dependencyTypes.map((name, index) => (
          <li>
            <>
              <h3>{name}</h3>
              <p>{dependencyDescriptions[index]}</p>
            </>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="landing-section formats" id="formats" aria-labelledby="formats-title">
  <div class="wrap">
    <div class="section-intro">
      <h2 id="formats-title">{landingSections[3].title}</h2>
      <p>{landingSections[3].introduction}</p>
    </div>
    <ul class="format-list">
      {
        careFormats.map((name, index) => (
          <li>
            <>
              <h3>{name}</h3>
              <p>{formatDescriptions[index]}</p>
            </>
          </li>
        ))
      }
    </ul>
    {
      detailRoutesAvailable && (
        <a class="text-link" href="/napriamy/">
          Більше про напрями й формати <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</section>
