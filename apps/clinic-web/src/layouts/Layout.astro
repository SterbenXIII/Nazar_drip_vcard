---
import { resolveTheme } from '../config/theme.mjs'
import { resolvePageSeo, resolveSeoConfig } from '../config/seo.mjs'
import GoogleAnalytics from '../components/GoogleAnalytics.astro'

interface Props {
  title: string
  description: string
  routePolicy: 'closed' | 'home' | 'supporting'
}

const { title, description, routePolicy } = Astro.props
const theme = resolveTheme()
const { mode } = resolveSeoConfig()
const seo = resolvePageSeo(routePolicy)
import '../styles/global.css'
---

<!doctype html>
<html lang="uk" data-theme={theme} class:list={[routePolicy === 'home' && 'home-layout']}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={seo.robots} />
    <meta name="description" content={description} />
    {seo.canonical && <link rel="canonical" href={seo.canonical} />}
    {
      seo.social && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:locale" content="uk_UA" />
          <meta property="og:url" content={seo.canonical} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta name="twitter:card" content="summary" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    {mode === 'production' && <GoogleAnalytics />}
  </head>
  <body class:list={[routePolicy === 'home' && 'home-layout']}>
    <a class="skip-link" href="#content">Перейти до вмісту</a>
    <slot />
  </body>
</html>
