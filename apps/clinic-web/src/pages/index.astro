---
import Audience from '../components/Audience.astro'
import ConditionsSummary from '../components/ConditionsSummary.astro'
import Contact from '../components/Contact.astro'
import FamilySummary from '../components/FamilySummary.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import Process from '../components/Process.astro'
import ProgramSummary from '../components/ProgramSummary.astro'
import Services from '../components/Services.astro'
import { landingSections } from '../content/landing'
import Layout from '../layouts/Layout.astro'
import { homepageDescription, homepageTitle } from '../config/seo.mjs'

const isProduction = process.env.CLINIC_SITE_MODE === 'production'
---

<Layout
  title={isProduction
    ? homepageTitle
    : 'HAVENHUB — допомога людям із залежностями та їхнім близьким'}
  description={isProduction ? homepageDescription : landingSections[0].introduction}
  routePolicy="home"
>
  <Header />
  <main id="content" tabindex="-1">
    <Hero />
    <Audience />
    <Services />
    <ProgramSummary />
    <Process />
    <FamilySummary />
    <ConditionsSummary />
    <Contact />
  </main>
  <Footer />
</Layout>
