---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import PhotoGallery from '../components/PhotoGallery.astro'
import StagingIllustration from '../components/StagingIllustration.astro'
import { email, hotline, telegram, whatsapp } from '../content/customer-materials'
import EmailIcon from '../components/EmailIcon.astro'
import PhoneIcon from '../components/PhoneIcon.astro'
import TelegramIcon from '../components/TelegramIcon.astro'
import WhatsAppIcon from '../components/WhatsAppIcon.astro'
import { supportingPages, type SupportingPage } from '../content/supporting-pages'

export function getStaticPaths() {
  const siteMode = process.env.CLINIC_SITE_MODE ?? 'normal'
  const pages = siteMode === 'normal' && !import.meta.env.DEV ? [] : supportingPages

  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }))
}

const { page } = Astro.props as { page: SupportingPage }
const isDirectionsPage = page.slug === 'napriamy'
const isProgramPage = page.slug === 'programa'
const isFamilyPage = page.slug === 'rodyni'
const isConditionsPage = page.slug === 'umovy'
---

<Layout title={page.title} description={page.description} routePolicy="supporting">
  <Header
    hrefPrefix="/"
    directionsPage={isDirectionsPage}
    supportingPage={isFamilyPage || isConditionsPage}
  />
  <main
    id="content"
    tabindex="-1"
    class:list={[
      'support-page',
      isFamilyPage && 'support-page-family',
      isConditionsPage && 'support-page-conditions',
      isDirectionsPage && 'support-page-directions',
      isProgramPage && 'support-page-program',
    ]}
  >
    <div class="wrap">
      <header class="support-intro">
        {isFamilyPage && <p class="support-family-kicker">Для рідних і близьких</p>}
        {isConditionsPage && <p class="support-intro-kicker">HAVENHUB · Про центр</p>}
        {isDirectionsPage && <p class="support-intro-kicker">Напрями та формати допомоги</p>}
        {isProgramPage && <p class="support-intro-kicker">Підтримка починається з розмови</p>}
        <h1>{page.h1}</h1>
        <p class="support-description">{page.description}</p>
        {
          isConditionsPage && (
            <>
              <div class="support-conditions-hero-actions">
                <a class="support-primary-action" href="#conditions">
                  Дізнатися про умови
                </a>
                <a class="support-secondary-action" href="#contact">
                  Поставити запитання
                </a>
              </div>
              <figure class="support-conditions-hero-art">
                <img src="/havenhub-umovy-hero-leaves.svg" alt="" aria-hidden="true" />
                <figcaption>Індивідуальні обставини обговорюємо під час звернення</figcaption>
              </figure>
            </>
          )
        }
        {
          isFamilyPage && (
            <>
              <div class="support-family-hero-actions">
                <a class="support-primary-action" href={hotline.href}>
                  Поговорити з нами
                </a>
                <span>Перша первинна консультація безкоштовна</span>
              </div>
              <img
                class="support-family-hero-art"
                src="/havenhub-rodyni-hero-leaves.svg"
                alt=""
                aria-hidden="true"
              />
            </>
          )
        }
        {
          isDirectionsPage && (
            <svg
              class="support-intro-branch"
              viewBox="0 0 560 320"
              fill="none"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M16 286C151 237 282 151 548 166" stroke="#bdc9bc" stroke-width="2" />
              <g fill="#e7ebe4" stroke="#cbd5ca" stroke-width="1.5">
                <path d="M152 239C91 206 53 151 41 85c60 31 107 87 111 154Z" />
                <path d="M261 194C207 150 183 94 189 39c55 32 88 81 72 155Z" />
                <path d="M349 174C321 112 326 49 359 7c41 52 53 108 18 165Z" />
                <path d="M411 166C415 98 448 39 491 17c16 65-1 120-80 149Z" />
                <path d="M449 169C488 126 522 108 557 111c-15 43-48 66-108 58Z" />
              </g>
              <g fill="none" stroke="#cbd5ca" stroke-width="1.5">
                <path d="M152 239C119 177 75 122 41 85" />
                <path d="M261 194C242 134 213 78 189 39" />
                <path d="M349 174C352 106 356 49 359 7" />
                <path d="M411 166C447 106 472 55 491 17" />
                <path d="M449 169C490 143 524 123 557 111" />
              </g>
            </svg>
          )
        }
      </header>

      {
        isProgramPage && (
          <header class="support-program-heading">
            <h2>Від першого звернення — до наступного кроку</h2>
            <p>
              Починати можна з короткої розмови. Формат підтримки визначається після уточнення
              вашого запиту та обставин.
            </p>
          </header>
        )
      }

      <div class:list={['support-sections', isProgramPage && 'support-program-cards']}>
        {
          page.sections.map((section, index) => (
            <section
              class:list={[
                'support-section',
                index % 2 === 1 && 'support-section-muted',
                isFamilyPage && index === 0 && 'support-family-first-contact',
                isFamilyPage && index === 1 && 'support-family-steps-section',
                isFamilyPage && index === 2 && 'support-family-support-section',
                isFamilyPage && index === 3 && 'support-family-questions-section',
                isConditionsPage && index === 0 && 'support-conditions-approach',
                isConditionsPage && index === 1 && 'support-conditions-list-section',
                isConditionsPage && index === 2 && 'support-conditions-location',
                isConditionsPage && index === 3 && 'support-conditions-before',
                isDirectionsPage && index === 0 && 'support-section-dependency-types',
                isDirectionsPage && index === 1 && 'support-section-care-formats',
                isProgramPage && index < 4 && 'support-program-card',
                isProgramPage && index === 4 && 'support-program-stages',
                isProgramPage && index === 5 && 'support-program-customer-copy',
              ]}
              id={
                isConditionsPage
                  ? ['approach', 'conditions', 'location', 'before'][index]
                  : undefined
              }
              aria-labelledby={`section-${page.slug}-${index}`}
            >
              <div class="support-section-content">
                {isFamilyPage && index === 2 && (
                  <img
                    class="support-family-illustration"
                    src="/havenhub-rodyni-family-branches.svg"
                    alt=""
                    aria-hidden="true"
                  />
                )}
                {isProgramPage && index < 4 ? (
                  <h3 id={`section-${page.slug}-${index}`}>{section.heading}</h3>
                ) : (
                  <h2 id={`section-${page.slug}-${index}`}>{section.heading}</h2>
                )}
                {section.paragraphs
                  .slice(0, isProgramPage && index === 4 ? 1 : undefined)
                  .map((paragraph, paragraphIndex) => (
                    <p
                      class:list={[
                        isFamilyPage &&
                          index === 2 &&
                          paragraphIndex === 1 &&
                          'support-family-note',
                      ]}
                    >
                      {paragraph}
                    </p>
                  ))}
                {section.callout && (
                  <div
                    class:list={[
                      'support-family-callout',
                      isFamilyPage && index === 3 && 'support-family-privacy',
                    ]}
                  >
                    <strong>{section.callout.heading}</strong>
                    <p>{section.callout.paragraph}</p>
                  </div>
                )}
                {section.illustrationSlot && (
                  <StagingIllustration slot={section.illustrationSlot} />
                )}
                {section.items && (
                  <ul
                    class:list={[
                      'support-items',
                      isFamilyPage && index === 1 && 'support-family-steps',
                      isFamilyPage && index === 3 && 'support-family-questions',
                      isDirectionsPage && index === 0 && 'support-items-dependency-types',
                      isDirectionsPage && index === 1 && 'support-items-care-formats',
                      isConditionsPage && index === 1 && 'conditions-list',
                      isConditionsPage && index === 0 && 'support-conditions-principles',
                    ]}
                  >
                    {section.items.map((item, itemIndex) => (
                      <li
                        id={
                          isDirectionsPage && index === 1
                            ? [
                                'care-format-residential',
                                'care-format-outpatient',
                                'care-format-home-visit',
                              ][itemIndex]
                            : undefined
                        }
                      >
                        {isConditionsPage && index === 1 && (
                          <span class="support-conditions-number" aria-hidden="true">
                            {String(itemIndex + 1).padStart(2, '0')}
                          </span>
                        )}
                        {isFamilyPage && index === 1 && (
                          <span class="support-family-step-number" aria-hidden="true">
                            {itemIndex + 1}
                          </span>
                        )}
                        {isFamilyPage && index === 3 ? (
                          <>
                            <span class="support-family-question-number" aria-hidden="true">
                              {String(itemIndex + 1).padStart(2, '0')}
                            </span>
                            <span>{item.title}</span>
                          </>
                        ) : (
                          <>
                            <h3>{item.title}</h3>
                            <p>{item.description}</p>
                            {item.details?.length && (
                              <ul class="support-item-details">
                                {item.details.map((detail) => (
                                  <li>{detail}</li>
                                ))}
                              </ul>
                            )}
                          </>
                        )}
                        {isProgramPage && index === 4 && (
                          <span class="support-program-step-number" aria-hidden="true">
                            {itemIndex + 1}
                          </span>
                        )}
                        {isDirectionsPage && index === 0 && (
                          <span class="support-item-icon" aria-hidden="true">
                            {itemIndex === 0 ? (
                              <svg viewBox="0 0 32 32" fill="none">
                                <path
                                  d="M13 3h6v4l-1.5 2v3.5l3.5 2.5v11a3 3 0 0 1-3 3h-5a3 3 0 0 1-3-3V15l3.5-2.5V9L13 7V3Z"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                  stroke-linejoin="round"
                                />
                                <path d="M11 18h10" stroke="currentColor" stroke-width="1.8" />
                              </svg>
                            ) : itemIndex === 1 ? (
                              <svg viewBox="0 0 32 32" fill="none">
                                <rect
                                  x="4.9"
                                  y="13.2"
                                  width="13"
                                  height="13"
                                  rx="2"
                                  transform="rotate(-13 4.9 13.2)"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                />
                                <rect
                                  x="15"
                                  y="5"
                                  width="13"
                                  height="13"
                                  rx="2"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                />
                                <circle cx="19" cy="9" r="1" fill="currentColor" />
                                <circle cx="24" cy="14" r="1" fill="currentColor" />
                                <circle cx="9" cy="17" r="1" fill="currentColor" />
                                <circle cx="14" cy="22" r="1" fill="currentColor" />
                              </svg>
                            ) : (
                              <svg viewBox="0 0 32 32" fill="none">
                                <path
                                  d="M27 4C15.2 4.2 7 8.1 7 16c0 6.2 6.2 9.2 11.4 5.1C23.4 17.3 26 10.4 27 4Z"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                  stroke-linejoin="round"
                                />
                                <path
                                  d="M5 28c3.2-5.1 8.3-10 16.1-15.4M5.5 19c-2.3-1.5-3.2-4-3.2-7 4.4 0 7.8 1.1 9.5 3.7"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                />
                              </svg>
                            )}
                          </span>
                        )}
                        {isDirectionsPage && index === 1 && (
                          <span class="support-item-icon" aria-hidden="true">
                            {itemIndex === 0 ? (
                              <svg viewBox="0 0 32 32" fill="none">
                                <path
                                  d="m4 14 12-10 12 10M7 12v16h18V12M13 28v-9h6v9"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                />
                              </svg>
                            ) : itemIndex === 1 ? (
                              <svg viewBox="0 0 32 32" fill="none">
                                <circle
                                  cx="16"
                                  cy="9"
                                  r="3"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                />
                                <circle
                                  cx="6.5"
                                  cy="13"
                                  r="2.5"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                />
                                <circle
                                  cx="25.5"
                                  cy="13"
                                  r="2.5"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                />
                                <path
                                  d="M10.5 27v-4a5.5 5.5 0 0 1 11 0v4h-11ZM2 25v-3a4.5 4.5 0 0 1 8-2.8M30 25v-3a4.5 4.5 0 0 0-8-2.8"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                />
                              </svg>
                            ) : (
                              <svg viewBox="0 0 32 32" fill="none">
                                <path
                                  d="M5 19.5 7.2 12a3 3 0 0 1 2.9-2.2h11.8a3 3 0 0 1 2.9 2.2l2.2 7.5M4 19.5h24V25a2 2 0 0 1-2 2h-2M4 19.5V25a2 2 0 0 0 2 2h2"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                />
                                <path
                                  d="m8 19.5 1.8-5.7h12.4l1.8 5.7M8 23h.01M24 23h.01"
                                  stroke="currentColor"
                                  stroke-width="1.8"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                />
                              </svg>
                            )}
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                )}
                {isProgramPage && index === 4 && (
                  <p class="support-program-note">{section.paragraphs[1]}</p>
                )}
              </div>
            </section>
          ))
        }
      </div>

      {isConditionsPage && <PhotoGallery />}

      {
        isProgramPage && (
          <p class="support-program-price">
            <strong>Що з вартістю?</strong> Формат допомоги та вартість узгоджують після розмови з
            урахуванням конкретної ситуації.
          </p>
        )
      }

      <section
        id={isConditionsPage ? 'contact' : undefined}
        class:list={[
          'support-contact',
          isFamilyPage && 'support-family-contact',
          isConditionsPage && 'support-conditions-contact',
        ]}
        aria-labelledby="support-contact-title"
      >
        <div>
          <h2 id="support-contact-title">Обговорімо наступний крок</h2>
          <p>
            {
              isFamilyPage
                ? 'Перша консультація безкоштовна. Формат допомоги та вартість визначають після розмови з урахуванням ситуації.'
                : 'Перша консультація безкоштовна. Вартість визначають після консультації.'
            }
          </p>
        </div>
        <div
          class:list={[
            'support-contact-actions',
            isFamilyPage && 'support-family-contact-actions',
            isConditionsPage && 'support-conditions-contact-actions',
          ]}
        >
          <a class="support-primary-action" href={hotline.href}><PhoneIcon /> Зателефонувати</a>
          <a class="support-secondary-action" href={telegram.href}
            ><TelegramIcon /> Написати в Telegram</a
          >
          <a class="support-secondary-action" href={whatsapp.href}>
            <WhatsAppIcon /> Написати в WhatsApp
          </a>
          <a class="support-secondary-action" href={email.href}><EmailIcon /> Написати на email</a>
        </div>
      </section>
    </div>
  </main>
  <Footer site={isDirectionsPage} />
</Layout>

<style>
  .support-page {
    padding-block: clamp(2.5rem, 7vw, 6rem);
  }

  .support-intro {
    max-width: 52rem;
    margin: 0 auto clamp(2rem, 5vw, 4rem);
    text-align: center;
  }

  h1 {
    max-width: 15ch;
    margin: 0 auto;
    color: var(--text);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.12;
  }

  .support-description {
    max-width: 42rem;
    margin: 1.25rem auto 0;
    color: var(--text-muted);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.7;
  }

  .support-sections {
    max-width: 58rem;
    margin: 0 auto;
  }

  .support-section {
    padding: clamp(1.5rem, 4vw, 2.75rem) clamp(0.25rem, 3vw, 2rem);
    border-top: 1px solid var(--border);
  }

  .support-section-muted {
    border-radius: var(--radius-md);
    background: var(--surface-muted);
    border-top-color: transparent;
  }

  .support-section-content {
    max-width: 48rem;
    margin-inline: auto;
  }

  h2 {
    margin: 0 0 1rem;
    color: var(--text);
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    line-height: 1.25;
  }

  .support-section p {
    max-width: 68ch;
    margin: 0 0 0.875rem;
    color: var(--text-muted);
    line-height: 1.75;
  }

  .support-section p:last-child {
    margin-bottom: 0;
  }

  .support-items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .support-items li {
    min-width: 0;
    padding: 1.125rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  h3 {
    margin: 0 0 0.5rem;
    color: var(--text);
    font-size: 1rem;
  }

  .support-items p {
    font-size: 0.9375rem;
  }

  .support-item-details {
    display: grid;
    gap: 0.5rem;
    margin: 0.25rem 0 0;
    padding-left: 1.25rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    list-style: disc;
  }

  .support-items .support-item-details li {
    min-height: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    list-style: disc;
  }

  .support-contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.5rem;
    max-width: 58rem;
    margin: clamp(2rem, 5vw, 4rem) auto 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: var(--primary);
    color: var(--primary-foreground);
  }

  .support-contact h2,
  .support-contact p {
    color: inherit;
  }

  .support-contact p {
    margin: 0;
    line-height: 1.6;
  }

  .support-contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .support-contact-actions a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.125rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-weight: 700;
    text-decoration: none;
  }

  .support-primary-action {
    background: var(--surface);
    color: var(--text);
  }

  .support-secondary-action {
    border-color: currentcolor;
    color: inherit;
  }

  .support-contact-actions a:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .support-page-conditions {
    padding-block: 0 4rem;
    background: #f6f3eb;
  }

  .support-page-conditions .support-intro {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(17rem, 0.9fr);
    grid-template-rows: auto auto auto 1fr;
    align-items: center;
    gap: 0.5rem clamp(1.5rem, 5vw, 4rem);
    max-width: none;
    min-height: 31rem;
    margin: 0 0 2.5rem;
    padding: clamp(3rem, 7vw, 5.5rem) 0;
    text-align: left;
  }

  .support-page-conditions .support-intro-kicker,
  .support-page-conditions .support-intro h1,
  .support-page-conditions .support-description,
  .support-page-conditions .support-conditions-hero-actions {
    grid-column: 1;
    margin-inline: 0;
  }

  .support-page-conditions .support-intro-kicker {
    align-self: end;
    margin: 0;
    color: #477269;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .support-page-conditions .support-intro h1 {
    max-width: 16ch;
    margin: 0.75rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5.3vw, 4.75rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }

  .support-page-conditions .support-description {
    max-width: 39rem;
    margin: 0.75rem 0 0;
    color: var(--text-muted);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.75;
  }

  .support-conditions-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .support-page-conditions .support-conditions-hero-actions a {
    min-height: 3rem;
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
  }

  .support-conditions-hero-art {
    position: relative;
    grid-column: 2;
    grid-row: 1 / span 4;
    width: min(100%, 28rem);
    height: 27rem;
    justify-self: end;
    margin: 0;
    border-radius: 50% 50% 1.25rem 1.25rem;
    background: #e8eee6;
    overflow: hidden;
  }

  .support-conditions-hero-art img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1.25rem;
  }

  .support-conditions-hero-art figcaption {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    padding: 0.875rem 1rem;
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    color: var(--text);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .support-page-conditions .support-sections {
    display: grid;
    max-width: none;
    gap: 1rem;
  }

  .support-page-conditions .support-section {
    margin: 0;
    padding: clamp(1.75rem, 5vw, 4rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    scroll-margin-top: 2rem;
  }

  .support-page-conditions .support-section-content {
    max-width: 64rem;
  }

  .support-page-conditions .support-section h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

