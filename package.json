{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "v-card",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "setup": "pnpm install && pnpm run link",
    "link": "pnpm recursive exec -- pnpm link --global",
    "refresh": "rm -rf node_modules **/node_modules pnpm-lock.yaml && pnpm install",
    "build:all": "pnpm --filter \"@vcard/*\" build",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "clean": "pnpm recursive exec -- rm -rf ./dist ./node_modules && rm -rf node_modules pnpm-lock.yaml && pnpm install",
    "nuclear-clear": "pnpm -r exec rm -rf dist .tsbuildinfo",
    "lint": "eslint . && pnpm --filter \"@vcard/*\" lint",
    "lint:fix": "eslint . --fix && pnpm --filter \"@vcard/*\" lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylelint": "stylelint \"apps/web/src/**/*.{css,astro}\"",
    "stylelint:fix": "stylelint \"apps/web/src/**/*.{css,astro}\" --fix",
    "mdlint": "markdownlint-cli2 \"**/*.md\"",
    "mdlint:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "typecheck": "pnpm --filter \"@vcard/*\" exec tsc --noEmit",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/web/**/*.astro": [
      "eslint --fix --config apps/web/eslint.config.js",
      "prettier --write",
      "stylelint --fix"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "dotenv": "^17.2.4",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "markdownlint-cli2": "^0.23.2",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.1.1",
    "stylelint-config-standard": "^40.0.0",
    "tsc-alias": "^1.8.16",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.29.1"
}
