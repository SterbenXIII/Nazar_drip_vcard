# ==============================================================================
# Auto-generated by Ansible - DO NOT EDIT MANUALLY
# ==============================================================================
# Generated: {{ ansible_date_time.iso8601 }}
# Host: {{ ansible_hostname }}
# ==============================================================================

# ==============================================================================
# 1. ЗАГАЛЬНІ НАЛАШТУВАННЯ (Infrastructure)
# ==============================================================================
DOMAIN_NAME="{{ domain_name | default('') }}"
NODE_ENV="{{ node_env | default('') }}"
TIMEZONE="{{ timezone | default('') }}"

# ==============================================================================
# 2. БЕКЕНД (Node.js / Hono)
# ==============================================================================
BACKEND_PORT="{{ backend_port | default('') }}"
WEBHOOK_SECRET="{{ webhook_secret | default('') }}"

# --- GMAIL OAUTH2 (Сповіщення) ---
SMTP_USER="{{ smtp_user | default('') }}"
GMAIL_CLIENT_ID="{{ gmail_client_id | default('') }}"
GMAIL_CLIENT_SECRET="{{ gmail_client_secret | default('') }}"
GMAIL_REFRESH_TOKEN="{{ gmail_refresh_token | default('') }}"

# Email, на який будуть приходити заявки з сайту
ADMIN_EMAIL="{{ admin_email | default('') }}"

# Notification providers
ENABLED_PROVIDERS="{{ enabled_providers | default('TELEGRAM,EMAIL') }}"

# ==============================================================================
# 3. ТЕЛЕГРАМ БОТ (Адмінка та сповіщення)
# ==============================================================================
TELEGRAM_BOT_TOKEN="{{ telegram_bot_token | default('') }}"
TELEGRAM_MASTER_ID="{{ telegram_master_id | default('') }}"
TELEGRAM_NOTIFY_IDS="{{ telegram_notify_ids | default('') }}"

# ==============================================================================
# 4. N8N AUTOMATION (Optional)
# ==============================================================================
N8N_PORT="{{ n8n_port | default('5679') }}"
N8N_HOST="{{ n8n_host | default(domain_name | default('')) }}"
N8N_PROTOCOL="{{ n8n_protocol | default('https') }}"
N8N_ENCRYPTION_KEY="{{ n8n_encryption_key | default('') }}"
N8N_COMMUNITY_PACKAGES_ENABLED="{{ n8n_community_packages_enabled | default('true') }}"
GENERIC_TIMEZONE="{{ generic_timezone | default(timezone | default('')) }}"

# --- База даних Postgres (для n8n) ---
POSTGRES_NON_ROOT_USER="{{ postgres_non_root_user | default('n8n') }}"
POSTGRES_NON_ROOT_PASSWORD="{{ postgres_non_root_password | default('') }}"
{% if postgres_password is defined and postgres_password %}
POSTGRES_USER="{{ postgres_non_root_user | default('n8n') }}"
POSTGRES_PASSWORD="{{ postgres_password | default('') }}"
POSTGRES_DB="n8n"
{% endif %}

# --- Public verification metadata ---
PUBLIC_GSC_VERIFICATION="{{ public_gsc_verification | default('') }}"
