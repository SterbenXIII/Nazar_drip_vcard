# Generated by Ansible; stored on the VPS with mode 0600.
VPS_IP="{{ vps_ip | default('') }}"
DOMAIN_NAME="{{ domain_name | default('havenhub.com.ua') }}"
NODE_ENV="{{ node_env | default('production') }}"
TIMEZONE="{{ timezone | default('Europe/Kyiv') }}"
BACKEND_PORT="{{ backend_port | default('5678') }}"
WEBHOOK_SECRET="{{ webhook_secret | default('') }}"
ENABLED_PROVIDERS="{{ enabled_providers | default('TELEGRAM') }}"
TELEGRAM_BOT_TOKEN="{{ telegram_bot_token | default('') }}"
TELEGRAM_MASTER_ID="{{ telegram_master_id | default('') }}"
TELEGRAM_NOTIFY_IDS="{{ telegram_notify_ids | default('') }}"
